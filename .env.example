# Copy this file to .env and fill in real values.
# .env is gitignored and will never be committed.

# GoHighLevel — see handoffs/gohighlevel.md
GHL_API_KEY=
GHL_LOCATION_ID=

# Netlify (hosting) — see handoffs/netlify.md
NETLIFY_PERSONAL_ACCESS_TOKEN=

# Supabase (database) — see handoffs/supabase.md
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role bypasses all security rules. Server-side only, never in a web page.
SUPABASE_SERVICE_ROLE_KEY=
# Account-level token that lets the agent manage the project
SUPABASE_ACCESS_TOKEN=

# Google Analytics 4 — see handoffs/google-ads-analytics.md
GA4_PROPERTY_ID=

# Google Ads — see handoffs/google-ads-analytics.md
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json
